# 开发环境 Dockerfile
FROM node:22.14.0-alpine

# 设置工作目录
WORKDIR /app

# 设置 npm 镜像源（国内加速）
RUN npm config set registry https://registry.npmmirror.com

# 复制 package.json 和 package-lock.json
COPY package*.json ./

# 安装依赖
RUN npm install

# 复制项目文件
COPY . .

# 暴露端口
EXPOSE 5173

# 启动开发服务器
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
