# ==================== 应用配置 ====================
APP_NAME=career-planning-agent
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# ==================== 数据库配置 ====================
# PostgreSQL（关系型数据库）
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=career_user
POSTGRES_PASSWORD=your_strong_password_here
POSTGRES_DB=career_planning

# Redis（缓存）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAX_CONNECTIONS=50

# OpenSearch（搜索引擎 + 向量检索）
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=admin
OPENSEARCH_USE_SSL=false
OPENSEARCH_VERIFY_CERTS=false
# 索引名称
OPENSEARCH_JOB_INDEX=jobs
OPENSEARCH_RESUME_INDEX=resumes
OPENSEARCH_QUESTION_INDEX=questions

# ==================== LLM 配置（国内服务商）====================
# 支持：qwen（通义千问）/ zhipu（智谱）/ deepseek / moonshot（月之暗面）
LLM_PROVIDER=qwen
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=sk-your-api-key-here
LLM_MODEL=qwen-turbo
LLM_TIMEOUT=60
LLM_MAX_RETRIES=3
LLM_TEMPERATURE=0.2
LLM_DRY_RUN=false

# ==================== Embedding 模型配置 ====================
# 支持：qwen / zhipu / local（sentence-transformers）
EMBEDDING_PROVIDER=qwen
EMBEDDING_MODEL=text-embedding-v2
EMBEDDING_API_KEY=sk-your-api-key-here
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_DIMENSION=1536
# 如果使用本地模型（sentence-transformers）
EMBEDDING_LOCAL_MODEL=BAAI/bge-large-zh-v1.5
EMBEDDING_DEVICE=cpu

# ==================== JWT 安全配置 ====================
JWT_SECRET_KEY=change-this-to-a-random-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==================== CORS 配置 ====================
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:80
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOW_HEADERS=*

# ==================== 文件上传配置 ====================
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10485760
ALLOWED_FILE_TYPES=pdf,doc,docx,png,jpg,jpeg

# ==================== 日志配置 ====================
LOG_LEVEL=INFO
LOG_DIR=./logs
LOG_FORMAT=json

# ==================== OCR 配置（可选）====================
OCR_PROVIDER=paddleocr
OCR_LANG=ch

# ==================== 限流配置 ====================
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# ==================== 缓存配置 ====================
CACHE_TTL=3600
CACHE_ENABLED=true

# ==================== 向量检索配置 ====================
# OpenSearch k-NN 参数
KNN_VECTOR_DIMENSION=1536
KNN_EF_SEARCH=100
KNN_M=16
